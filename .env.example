# API server
PORT=3002
DB_PATH=data/gestao-confeccao.sqlite

# Cópia para PostgreSQL. A API em execução ignora esta variável e continua em DB_PATH.
# Preencha só no ambiente. Não grave usuário nem senha neste arquivo.
# DATABASE_URL=

# Web dev server proxy target (defaults to http://127.0.0.1:3002)
VITE_API_TARGET=http://127.0.0.1:3002

# Asaas — SOMENTE SANDBOX. Nunca use a API Key de produção.
# Nomes oficiais: ASAAS_API_KEY e ASAAS_BASE_URL.
# Aliases aceitos (typos do Cloud Agent): ASAAS_APi_KEY e ASSAS_BASE_URL.
# Base obrigatória do sandbox (produção é recusada pela aplicação):
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3 // pragma: allowlist secret
ASAAS_API_KEY=
# Token do webhook (header asaas-access-token). NÃO use a API Key aqui.
ASAAS_WEBHOOK_TOKEN=
